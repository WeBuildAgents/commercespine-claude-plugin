#!/usr/bin/env node
'use strict';

// ecombrain-config — report the resolved configuration and token status.
// Never prints the token itself.
//
// Usage:
//   ecombrain-config            # human-readable status
//   ecombrain-config --json     # machine-readable status

const path = require('path');
const config = require(path.join(__dirname, '..', 'lib', 'config'));

function maskToken(creds) {
  if (!creds || !creds.token) return null;
  const t = creds.token;
  if (t.length <= 8) return '****';
  return `${t.slice(0, 4)}…${t.slice(-4)} (${t.length} chars)`;
}

function main() {
  const asJson = process.argv.includes('--json');
  const creds = config.readCredentials();

  const status = {
    frontendUrl: config.frontendUrl(),
    apiUrl: config.apiUrl(),
    credentialsPath: config.credentialsPath(),
    tokenPresent: config.hasToken(),
    tokenPreview: maskToken(creds),
    obtainedAt: creds && creds.obtainedAt ? creds.obtainedAt : null,
  };

  if (asJson) {
    process.stdout.write(JSON.stringify(status, null, 2) + '\n');
    return;
  }

  const lines = [
    'Ecombrain plugin configuration',
    '------------------------------',
    `Frontend URL:      ${status.frontendUrl}`,
    `API URL:           ${status.apiUrl}`,
    `Credentials file:  ${status.credentialsPath}`,
    `Token present:     ${status.tokenPresent ? 'yes' : 'no'}`,
  ];
  if (status.tokenPresent) {
    lines.push(`Token:             ${status.tokenPreview}`);
    lines.push(`Obtained at:       ${status.obtainedAt || 'unknown'}`);
  } else {
    lines.push('Next step:         run /ecombrain:login to authenticate.');
  }
  process.stdout.write(lines.join('\n') + '\n');
}

main();
