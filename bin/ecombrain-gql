#!/usr/bin/env node
'use strict';

// ecombrain-gql — execute a read-only GraphQL query against the Ecombrain Data
// Layer using the stored bearer token.
//
// Usage:
//   ecombrain-gql --query '<gql>' [--variables '<json>']
//   echo '<gql>' | ecombrain-gql            # read query from stdin
//
// Exit codes:
//   0  success (prints JSON `data` to stdout)
//   2  authentication problem (no token / rejected token) — user should re-login
//   1  any other error

const path = require('path');
const gql = require(path.join(__dirname, '..', 'lib', 'graphql'));

function parseArgs(argv) {
  const args = { query: null, variables: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === '--query' || a === '-q') args.query = argv[++i];
    else if (a === '--variables' || a === '-v') args.variables = argv[++i];
    else if (a === '--help' || a === '-h') args.help = true;
  }
  return args;
}

function readStdin() {
  return new Promise((resolve) => {
    if (process.stdin.isTTY) return resolve('');
    let data = '';
    process.stdin.setEncoding('utf8');
    process.stdin.on('data', (c) => (data += c));
    process.stdin.on('end', () => resolve(data));
  });
}

async function main() {
  const args = parseArgs(process.argv.slice(2));

  if (args.help) {
    process.stdout.write(
      "Usage: ecombrain-gql --query '<gql>' [--variables '<json>']\n" +
        '       echo \'<gql>\' | ecombrain-gql\n'
    );
    return;
  }

  let query = args.query;
  if (!query) {
    query = (await readStdin()).trim();
  }
  if (!query) {
    process.stderr.write('Error: no query provided (use --query or stdin).\n');
    process.exit(1);
  }

  let variables = {};
  if (args.variables) {
    try {
      variables = JSON.parse(args.variables);
    } catch (err) {
      process.stderr.write(`Error: --variables is not valid JSON: ${err.message}\n`);
      process.exit(1);
    }
  }

  try {
    const data = await gql.execute(query, variables);
    process.stdout.write(JSON.stringify(data, null, 2) + '\n');
  } catch (err) {
    if (err instanceof gql.AuthError) {
      process.stderr.write(err.message + '\n');
      process.exit(2);
    }
    process.stderr.write((err && err.message ? err.message : String(err)) + '\n');
    process.exit(1);
  }
}

main();
